    animFolder.Parent = char

    for i = 1, 3 do
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. newAnimations[i]
        anim.Parent = animFolder

        local track = humanoid:LoadAnimation(anim)
        animTracks[oldAnimations[i]] = track
    end

    humanoid.AnimationPlayed:Connect(function(animTrack)
        if not Settings.BloodlustKnifeActive then return end

        if animTrack and animTrack.Animation then
            local animId = tostring(animTrack.Animation.AnimationId):match("%d+")

            for idx = 1, 3 do
                local oldId = oldAnimations[idx]
                if animId == oldId then
                    playHitSound()

                    local newTrack = animTracks[oldId]
                    if newTrack and not newTrack.IsPlaying then
                        animTrack:Stop()
                        newTrack:Play()
                        newTrack.TimePosition = animTrack.TimePosition
                        newTrack.Speed = animTrack.Speed
                    end
                    break
                end
            end
        end
    end)

    char.ChildAdded:Connect(function(tool)
        if tool:IsA("Tool") and Settings.BloodlustKnifeActive then
            tool.Equipped:Connect(function()
                task.wait(0.1)
                for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
                    if track.Animation then
                        local animId = tostring(track.Animation.AnimationId):match("%d+")
                        for idx = 1, 3 do
                            if animId == oldAnimations[idx] then
                                track:Stop()
                                break
                            end
                        end
                    end
                end

                for i = 1, 3 do
                    local newTrack = animTracks[oldAnimations[i]]
                    if newTrack then
                        newTrack:Play()
                    end
                end
            end)

            tool.Activated:Connect(function()
                if Settings.BloodlustKnifeActive then
                    playHitSound()

                    for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
                        if track.Animation then
                            local animId = tostring(track.Animation.AnimationId):match("%d+")
                            for idx = 1, 3 do
                                if animId == oldAnimations[idx] then
                                    local newTrack = animTracks[oldAnimations[idx]]
                                    if newTrack and not newTrack.IsPlaying then
                                        track:Stop()
                                        newTrack:Play()
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)

    local oldState = humanoid.StateChanged
    humanoid.StateChanged:Connect(function(old, new)
        if Settings.BloodlustKnifeActive and new == Enum.HumanoidStateType.Physics then
            task.wait(0.1)
            for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
                if track.Animation then
                    local animId = tostring(track.Animation.AnimationId):match("%d+")
                    for idx = 1, 3 do
                        if animId == oldAnimations[idx] then
                            playHitSound()
                            break
                        end
                    end
                end
            end
        end
    end)
end

local function removeBloodlustKnife()
    Settings.BloodlustKnifeActive = false
    Settings.BloodlustBuffActive = false

    if BloodlustKnifeModel then
        for _, conn in pairs(BloodlustKnifeConnections) do
            conn:Disconnect()
        end
        BloodlustKnifeConnections = {}

        if BloodlustWeld and BloodlustWeld.Parent then
            BloodlustWeld:Destroy()
            BloodlustWeld = nil
        end

        task.spawn(function()
            local fadeSteps = 30
            local stepTime = 0.1
            for i = 1, fadeSteps do
                local transparency = i / fadeSteps
                for _, part in pairs(BloodlustKnifeModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = transparency
                        part.LocalTransparencyModifier = 0
                    end
                    if part:IsA("Decal") or part:IsA("Texture") then
                        part.Transparency = transparency
                    end
                end
                task.wait(stepTime)
            end
            BloodlustKnifeModel:Destroy()
            BloodlustKnifeModel = nil
        end)
    end

    -- Возвращаем обычную гравитацию
    workspace.Gravity = 196
end

local function createBloodlustKnife(duration, withBuff)
    local char = LocalPlayer.Character
    if not char then return end
    local rightArm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightArm")
    if not rightArm then return end

    removeBloodlustKnife()

    local knifeId = 11058401516
    local success, knifeObj = pcall(game.GetObjects, game, "rbxassetid://" .. knifeId)
    if not success or not knifeObj or #knifeObj == 0 then return end

    BloodlustKnifeModel = knifeObj[1]:Clone()
    BloodlustKnifeModel.Parent = rightArm

    removeOldEffects(BloodlustKnifeModel)

    for _, part in pairs(BloodlustKnifeModel:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = false
            part.CanCollide = false
            part.Transparency = 0
            part.LocalTransparencyModifier = 0
        end
    end

    local mainPart = BloodlustKnifeModel.PrimaryPart or BloodlustKnifeModel:FindFirstChildWhichIsA("BasePart")
    if not mainPart then
        BloodlustKnifeModel:Destroy()
        BloodlustKnifeModel = nil
        return
    end

    createTrail(mainPart)
    createBloodEffect(mainPart)

    BloodlustWeld = Instance.new("Weld")
    BloodlustWeld.Part0 = rightArm
    BloodlustWeld.Part1 = mainPart
    BloodlustWeld.C0 = CFrame.new(0, -0.90, -0.70) * CFrame.Angles(math.rad(180), math.rad(-90), math.rad(-105))
    BloodlustWeld.Parent = rightArm

    Settings.BloodlustKnifeActive = true
    Settings.BloodlustKnifeStartTime = tick()
    Settings.BloodlustKnifeDuration = duration
    Settings.BloodlustBuffActive = withBuff  -- true = удачный (25 сек), false = неудачный (15 сек)

    local tool = BloodlustKnifeModel:FindFirstChildOfClass("Tool")
    if tool then
        local conn = tool.Activated:Connect(function()
            playHitSound()
        end)
        table.insert(BloodlustKnifeConnections, conn)
    end

    setupAnimationReplacer()

    task.delay(duration, function()
        if Settings.BloodlustKnifeActive then
            removeBloodlustKnife()
        end
    end)
end

local function teleportBehindAttacker(attackerChar)
    local char = LocalPlayer.Character
    if not char or not attackerChar then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    local attackerRoot = attackerChar:FindFirstChild("HumanoidRootPart") or attackerChar:FindFirstChild("Torso") or attackerChar:FindFirstChild("Head")
    if not root or not attackerRoot then return end

    CreatePhantom(root.Position)

    local look = attackerRoot.CFrame.LookVector
    local behind = attackerRoot.Position - (look * 3) + Vector3.new(0, 1, 0)
    root.CFrame = CFrame.new(behind, attackerRoot.Position)

    if BloodlustAnimTrack and BloodlustAnimTrack.IsPlaying then
        BloodlustAnimTrack:Stop()
    end
    StopAnimation()
    Settings.BloodlustAnimationActive = false

    if attackerChar:FindFirstChild("Humanoid") then
        local attackerHumanoid = attackerChar.Humanoid
        for _, track in pairs(attackerHumanoid:GetPlayingAnimationTracks()) do
            track:Stop()
        end
    end
end

local function setupBloodlustCounter()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    if not humanoid or not root then return end

    local listening = true
    local startHealth = humanoid.Health

    humanoid.WalkSpeed = 0

    task.delay(1.64, function()
        listening = false
        if Settings.BloodlustAnimationActive then
            PlaySound("96188091140381", 0.5)
            Settings.BloodlustAnimationActive = false
            StopAnimation()
            -- НЕУДАЧНЫЙ КАУНТЕР: withBuff = false
            createBloodlustKnife(15, false)
            Settings.BloodlustCooldown = Settings.BloodlustCooldownDuration
        end
    end)

    local healthConn
    healthConn = humanoid.HealthChanged:Connect(function(newHealth)
        if not listening or not Settings.BloodlustAnimationActive then
            if healthConn then healthConn:Disconnect() end
            return
        end

        local damageTaken = startHealth - newHealth
        if damageTaken > 0 then
            listening = false
            Settings.BloodlustCounterSuccess = true
            Settings.BloodlustAnimationActive = false
            if healthConn then healthConn:Disconnect() end

            if BloodlustAnimTrack and BloodlustAnimTrack.IsPlaying then
                BloodlustAnimTrack:Stop()
            end
            StopAnimation()

            local attacker = nil
            local closestDist = 20
            for _, v in pairs(Players:GetPlayers()) do
                if v ~= LocalPlayer then
                    local vChar = v.Character
                    if vChar and vChar:FindFirstChild("HumanoidRootPart") then
                        local dist = (vChar.HumanoidRootPart.Position - root.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            attacker = vChar
                        end
                    end
                end
            end

            if attacker then
                PlaySound("136152007714410", 0.5)
                teleportBehindAttacker(attacker)
            end

            -- УДАЧНЫЙ КАУНТЕР: withBuff = true
            createBloodlustKnife(25, true)
            Settings.BloodlustCooldown = Settings.BloodlustCooldownDuration
        end
    end)
end

local function StartBloodlust()
    if Settings.BloodlustCooldown > 0 then return end
