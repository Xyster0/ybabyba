-- ===== АНИМАЦИИ =====
local CurrentAnimation = nil
local KillAnimationConn = nil
local Humanoid = nil

local function LoadAnimation(animId, looped)
    local char = LocalPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end

    if CurrentAnimation and CurrentAnimation.IsPlaying then
        CurrentAnimation:Stop()
        CurrentAnimation = nil
    end

    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. animId

    local track = humanoid:LoadAnimation(anim)
    track.Looped = looped or false

    return track
end

local function PlayAnimation(animId, looped)
    local track = LoadAnimation(animId, looped)
    if track then
        track:Play()
        CurrentAnimation = track
    end
    return track
end

local function StopAnimation()
    if CurrentAnimation and CurrentAnimation.IsPlaying then
        CurrentAnimation:Stop()
        CurrentAnimation = nil
    end
end

