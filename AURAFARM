        statusText.Text = "⚡ BARRAGE ⚡"
        statusText.TextColor3 = Color3.fromRGB(255, 100, 255)
        timerText.Text = string.format("%.1fs", timeLeft)
        timerText.TextColor3 = Color3.fromRGB(255, 100, 255)
    elseif Settings.GreatestHighActive then
        tapGui.Visible = true
        statusText.Text = "⚡ GREATEST HIGH ⚡"
        statusText.TextColor3 = Color3.fromRGB(100, 255, 100)
        timerText.Text = ""
    elseif Settings.KillAnimationActive then
        tapGui.Visible = true
        statusText.Text = "💀 KILL 💀"
        statusText.TextColor3 = Color3.fromRGB(255, 0, 0)
        timerText.Text = ""
    elseif Settings.BloodlustAnimationActive then
        tapGui.Visible = true
        statusText.Text = "🩸 BLOODLUST 🩸"
        statusText.TextColor3 = Color3.fromRGB(255, 0, 0)
        timerText.Text = ""
    elseif Settings.BloodlustKnifeActive then
        tapGui.Visible = true
