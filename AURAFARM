-- Функция создания фантома
local function CreatePhantom(pos)
    local char = LocalPlayer.Character
    if not char then return end

    local phantomFolder = Instance.new("Model")
    phantomFolder.Parent = workspace
    phantomFolder.Name = "GreatestHighPhantom"

    local primary = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    local offset = primary and (primary.Position - pos) or Vector3.new(0,0,0)

    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Transparency < 1 then
            local phantom = Instance.new("Part")
            phantom.Size = part.Size
            phantom.CFrame = part.CFrame - offset
            phantom.Name = part.Name
            phantom.Anchored = true
            phantom.CanCollide = false
            phantom.Material = Enum.Material.Neon
            phantom.Color = Color3.fromRGB(150, 150, 255)
            phantom.Transparency = 0.3
            phantom.Parent = phantomFolder

            local tween = TweenService:Create(phantom, TweenInfo.new(1, Enum.EasingStyle.Linear), {Transparency = 1})
            tween:Play()
        end
    end

    Debris:AddItem(phantomFolder, 1.1)
end

