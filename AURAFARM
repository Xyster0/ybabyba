    elseif Settings.CurrentSpeed >= 250 then
        tapGui.Visible = true
        statusText.Text = "⚡ MAX SPEED ⚡"
        statusText.TextColor3 = Color3.fromRGB(0, 255, 255)
        timerText.Text = ""
    elseif Settings.CWindowActive then
