-- Naoya Morph
local function PerfectNaoyaMorph()
    local char = LocalPlayer.Character
    if not char then return end
    local head = char:FindFirstChild("Head")
    if not head then return end

    for _, obj in pairs(char:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Shirt") or obj:IsA("Pants") then
            obj:Destroy()
        end
    end

    head.Transparency = 1
    local face = head:FindFirstChildOfClass("Decal")
    if face then face:Destroy() end

    pcall(function()
        local objects = game:GetObjects("rbxassetid://115937922832993")
        for _, obj in pairs(objects) do
            local hair = obj:IsA("Accessory") and obj or obj:FindFirstChildOfClass("Accessory")
            if hair then
                hair.Parent = char
                local handle = hair:FindFirstChild("Handle")
                if handle then
                    handle.CanCollide = false
                    local weld = Instance.new("Weld", handle)
                    weld.Part0 = handle
                    weld.Part1 = head
                    weld.C1 = CFrame.new(0, 0, 0)
                end
            end
        end
    end)

    pcall(function()
        local targetModel = Players:CreateHumanoidModelFromUserId(Players:GetUserIdFromNameAsync("Skylong888"))
        if targetModel then
            for _, v in pairs(targetModel:GetChildren()) do
                if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
                    v:Clone().Parent = char
                end
            end
            targetModel:Destroy()
        end
    end)
end

-- ПОИСК ЦЕЛИ (ИГРОКИ + NPC)
local function GetClosestTarget()
    local closest = nil
    local shortestDist = math.huge
    local center = Camera.ViewportSize / 2
    
    -- ПОИСК ИГРОКОВ
    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            local humanoid = v.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local part = v.Character:FindFirstChild("HumanoidRootPart") or v.Character:FindFirstChild("Torso") or v.Character:FindFirstChild("Head")
                if part then
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - center).magnitude
                        if dist < shortestDist then
                            closest = v.Character
                            shortestDist = dist
                        end
                    end
                end
            end
        end
    end
    
    -- ПОИСК NPC (все модели с Humanoid)
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("Model") and v ~= LocalPlayer.Character then
            local humanoid = v:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                -- Проверяем что это не игрок
                local isPlayer = false
                for _, player in pairs(Players:GetPlayers()) do
                    if player.Character == v then
                        isPlayer = true
                        break
                    end
                end
                
                if not isPlayer then
                    local part = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso") or v:FindFirstChild("Head") or v:FindFirstChild("UpperTorso")
                    if part then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - center).magnitude
                            if dist < shortestDist then
                                closest = v
                                shortestDist = dist
                            end
                        end
                    end
                end
            end
        end
    end
    
    return closest
end

-- ГЛАВНЫЙ ЦИКЛ АИМА
RunService.RenderStepped:Connect(function()
    if Settings.AimbotEnabled then
        -- Если цели нет - ищем
        if not Settings.Target then
            Settings.Target = GetClosestTarget()
            if Settings.Target then
                print("Цель найдена:", Settings.Target.Name or "NPC")
            end
        end
        
        -- Если цель есть - проверяем жива ли и наводимся
        if Settings.Target then
            local humanoid = Settings.Target:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local part = Settings.Target:FindFirstChild("HumanoidRootPart") or 
                            Settings.Target:FindFirstChild("Torso") or 
                            Settings.Target:FindFirstChild("Head") or 
                            Settings.Target:FindFirstChild("UpperTorso")
                if part then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
                end
            else
                Settings.Target = nil -- цель мертва, сбрасываем
            end
        end
    end
end)

-- ВКЛ/ВЫКЛ ПО E
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.E then
        Settings.AimbotEnabled = not Settings.AimbotEnabled
        if Settings.AimbotEnabled then
            Settings.Target = GetClosestTarget()
            if Settings.Target then
                print("Аим включен, цель:", Settings.Target.Name or "NPC")
            else
                print("Аим включен, целей нет")
            end
        else
            Settings.Target = nil
            print("Аим выключен")
        end
    end
end)

-- НОРМАЛЬНЫЙ РАЗГОН
RunService.Heartbeat:Connect(function()
    local dt = tick() - lastTime
    lastTime = tick()
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Проверка движения
    if not lastPosition then
        lastPosition = root.Position
        return
    end
    
    local moved = (root.Position - lastPosition).magnitude > 0.1
    lastPosition = root.Position
    
    -- FRAME логика
    if Settings.FrameEnabled then
        if moved then
            Settings.Acceleration = Settings.Acceleration + (dt * ACCEL_RATE)
            Settings.CurrentSpeed = math.min(Settings.MAX_SPEED, 25 + Settings.Acceleration)
        else
            Settings.Acceleration = 0
            Settings.CurrentSpeed = 25
        end
    else
        Settings.CurrentSpeed = 25
        Settings.Acceleration = 0
    end
    
    humanoid.WalkSpeed = Settings.CurrentSpeed
end)

-- Фантомы
local function CreateGhost()
    if Settings.CurrentSpeed < 50 then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    local ghostFolder = Instance.new("Model")
    ghostFolder.Parent = workspace
    ghostFolder.Name = "GhostEffect"
    
    for _, part in pairs(char:GetChildren()) do
        if part:IsA("BasePart") and part.Transparency < 1 then
            local ghost
            
            if part.Name == "Head" then
                ghost = Instance.new("Part")
                ghost.Size = Vector3.new(1.2, 1.2, 1.2)
                ghost.CFrame = part.CFrame
                ghost.Name = "CylinderHead"
                local mesh = Instance.new("SpecialMesh", ghost)
                mesh.MeshType = Enum.MeshType.Cylinder
            else
                ghost = Instance.new("Part")
                ghost.Size = part.Size
                ghost.CFrame = part.CFrame
                ghost.Name = part.Name
            end
            
            ghost.Anchored = true
            ghost.CanCollide = false
            ghost.Material = Enum.Material.Neon
            ghost.Color = Color3.fromRGB(150, 150, 255)
            ghost.Transparency = 0.3
            ghost.Parent = ghostFolder
            
            local tween = TweenService:Create(ghost, TweenInfo.new(1), {Transparency = 1})
            tween:Play()
        end
    end
    
    Debris:AddItem(ghostFolder, 1.1)
end

-- Цикл фантомов
task.spawn(function()
    while true do
        if Settings.FreestyleEnabled then
            local speed = Settings.CurrentSpeed
            local waitTime = 0.2
            
            if speed >= 200 then
                waitTime = 0.05
            elseif speed >= 100 then
                waitTime = 0.1
            elseif speed >= 50 then
                waitTime = 0.2
            else
                task.wait(0.2)
                continue
            end
            
            CreateGhost()
            task.wait(waitTime)
        else
            task.wait(0.2)
        end
    end
end)

