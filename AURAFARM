-- ОСНОВНОЙ ЦИКЛ
RunService.Heartbeat:Connect(function()
    local dt = tick() - lastTime
    lastTime = tick()
    local currentTime = tick()

    local char = LocalPlayer.Character
    if not char then return end

    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    if not root then return end

    -- ОТСЛЕЖИВАНИЕ УРОНА ДЛЯ СТАНА
    if humanoid and humanoid.Health ~= lastHealth then
        local damageTaken = lastHealth - humanoid.Health
        if damageTaken >= 1.9 and not Settings.Frozen and not Settings.BloodlustAnimationActive then
            
            -- Определяем длительность стана (0.5 если есть бафф, иначе 0.7)
            local stunDuration = 0.7
            if Settings.BloodlustBuffActive and Settings.BloodlustKnifeActive then
                stunDuration = 0.5
            end
            
            Settings.DamageStun = true
            Settings.DamageStunEndTime = currentTime + stunDuration
        end
        lastHealth = humanoid.Health
    end

    -- Проверка окончания стана
    if Settings.DamageStun and currentTime >= Settings.DamageStunEndTime then
        Settings.DamageStun = false
    end

    UpdateMainGUI()
    UpdateTapGUI()

    if Settings.Frozen then
        if currentTime >= Settings.FrozenUntil then
            for _, part in pairs(Settings.FrozenParts) do
                if part and part.Parent then
                    part.Anchored = false
                end
            end
            Settings.FrozenParts = {}

            if humanoid then
                humanoid.WalkSpeed = 25
                humanoid.JumpPower = 50
                humanoid.AutoRotate = true
                humanoid.PlatformStand = false
            end

            Settings.Frozen = false
            Settings.CurrentSpeed = 25
        end
        return
    end

    if Settings.DamageStun then
        humanoid.WalkSpeed = 0
    end

    if not Settings.NaoyaEnabled then
        Settings.CurrentSpeed = 25
        humanoid.WalkSpeed = 25
        return
    end

    -- Кулдауны тикают всегда
    if Settings.BarrageCooldown > 0 then
        Settings.BarrageCooldown = Settings.BarrageCooldown - dt
    end
    if Settings.GreatestHighCooldown > 0 then
        Settings.GreatestHighCooldown = Settings.GreatestHighCooldown - dt
    end
    if Settings.BloodlustCooldown > 0 then
        Settings.BloodlustCooldown = Settings.BloodlustCooldown - dt
    end

    -- ===== БАФФЫ ОТ ТАНТО =====
    if Settings.BloodlustKnifeActive then
        if Settings.BloodlustBuffActive then
            -- УДАЧНЫЙ КАУНТЕР: меняем гравитацию для высоких прыжков
            workspace.Gravity = 120  -- МЕНЯЙ ТУТ ЦИФРУ (196 - норма, 120 - высоко, 80 - очень высоко)
            
            -- БАЗОВАЯ СКОРОСТЬ 35 (только при удачном)
            if not Settings.SpeedBoostActive then
                Settings.CurrentSpeed = 35
            end
        else
            -- НЕУДАЧНЫЙ КАУНТЕР: возвращаем обычную гравитацию
            workspace.Gravity = 196
            -- Скорость НЕ меняем
        end
    else
        -- НОЖА НЕТ: обычная гравитация
        workspace.Gravity = 196
        if not Settings.SpeedBoostActive and Settings.CurrentSpeed < 25 then
            Settings.CurrentSpeed = 25
        end
    end

    if Settings.BloodlustAnimationActive then
        humanoid.WalkSpeed = 0
        return
    end

    if Settings.BarrageActive and Settings.BarrageTarget then
        local targetRoot = Settings.BarrageTarget:FindFirstChild("HumanoidRootPart") or Settings.BarrageTarget:FindFirstChild("Torso") or Settings.BarrageTarget:FindFirstChild("Head")
        if targetRoot then
            local targetHumanoid = Settings.BarrageTarget:FindFirstChild("Humanoid")
            if targetHumanoid and targetHumanoid.Health > 0 then
                Settings.BarrageTime = Settings.BarrageTime + dt

                if Settings.BarrageTime >= Settings.BarrageDuration then
                    Settings.BarrageActive = false
                    Settings.BarrageTarget = nil
                    Settings.CCooldownActive = true
                    Settings.CWindowStart = currentTime
                    SetScreenEffect(0)
                    StopAnimation()
                else
                    local angle = (tick() * (Settings.BarrageSpeed / 8)) % (2 * math.pi)
                    local offset = Vector3.new(math.cos(angle) * Settings.BarrageDistance, 0, math.sin(angle) * Settings.BarrageDistance)
                    root.CFrame = CFrame.new(targetRoot.Position + offset, targetRoot.Position)
                    humanoid.WalkSpeed = 0
                end
            else
                PlaySound("126745072633218", 0.5)

                StopAnimation()
                SetScreenEffect(0)

                task.delay(0.5, function()
                    if not Settings.BarrageActive then
                        Settings.KillAnimationActive = true
                        local killAnim = PlayAnimation("83842514475555", false)

                        if KillAnimationConn then KillAnimationConn:Disconnect() end

                        KillAnimationConn = RunService.Heartbeat:Connect(function()
                            local vel = root.Velocity.Magnitude
                            if vel > 0.5 then
                                Settings.KillAnimationActive = false
                                StopAnimation()
                                if KillAnimationConn then
                                    KillAnimationConn:Disconnect()
                                    KillAnimationConn = nil
                                end
                            end
                        end)

                        task.delay(2, function()
                            Settings.KillAnimationActive = false
                            if KillAnimationConn then
                                KillAnimationConn:Disconnect()
                                KillAnimationConn = nil
                            end
                        end)
                    end
                end)

                Settings.BarrageActive = false
                Settings.BarrageTarget = nil
                Settings.CCooldownActive = true
                Settings.CWindowStart = currentTime
            end
        else
            Settings.BarrageActive = false
            Settings.BarrageTarget = nil
            Settings.CCooldownActive = true
            Settings.CWindowStart = currentTime
            SetScreenEffect(0)
            StopAnimation()
        end
        return
    end

    -- Если в стане, пропускаем логику скорости
    if Settings.DamageStun then
        return
    end

    local velocity = root.Velocity
    local lookVector = root.CFrame.LookVector
    local velocityDir = velocity.Magnitude > 0.1 and velocity.Unit or Vector3.new(0,0,0)
    local dotProduct = velocity.Magnitude > 0.1 and lookVector:Dot(velocityDir) or 0

    if velocity.Magnitude > 1 and dotProduct < -0.3 then
        ResetSpeed()
        Settings.CWindowActive = false
        Settings.CCooldownActive = false
        SetScreenEffect(0)
    end

    local isMoving = velocity.Magnitude > 0.5

    if Settings.SpeedBoostActive then
        Settings.CurrentSpeed = math.min(Settings.CurrentSpeed + ACCEL_RATE * dt, Settings.NextTargetSpeed)

        if Settings.CurrentSpeed < 250 then
            if Settings.CCooldownActive then
                if currentTime - Settings.CWindowStart >= 2.0 then
                    Settings.CWindowActive = true
                    Settings.CCooldownActive = false
                    Settings.CWindowStart = currentTime
                end
            elseif Settings.CWindowActive then
                if currentTime - Settings.CWindowStart >= Settings.PressWindow then
                    ResetSpeed()
                    Settings.CWindowActive = false
                    SetScreenEffect(0)
                end
            elseif not Settings.CCooldownActive and not Settings.CWindowActive then
                Settings.CCooldownActive = true
                Settings.CWindowStart = currentTime
            end
        else
            Settings.CWindowActive = false
            Settings.CCooldownActive = false
        end
    end

    if not isMoving then
        if Settings.CurrentSpeed > 25 and not Settings.BloodlustBuffActive then
            ResetSpeed()
            SetScreenEffect(0)
        end
    elseif not Settings.SpeedBoostActive and Settings.CurrentSpeed > 25 then
        if Settings.BloodlustBuffActive and Settings.BloodlustKnifeActive then
            -- Если есть бафф, скорость не падает ниже 35
            Settings.CurrentSpeed = math.max(Settings.CurrentSpeed - DECEL_RATE * dt, 35)
        else
            Settings.CurrentSpeed = math.max(Settings.CurrentSpeed - DECEL_RATE * dt, 25)
        end
    end

    humanoid.WalkSpeed = Settings.CurrentSpeed
end)

