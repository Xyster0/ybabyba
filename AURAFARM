            for _, v in pairs(targetModel:GetChildren()) do
                if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("BodyColors") then
                    v:Clone().Parent = char
                end
            end
            targetModel:Destroy()
        end
    end)
end

-- ПОИСК ЦЕЛИ
local function GetClosestPlayer()
    local closest = nil
    local shortestDist = math.huge
    local center = Camera.ViewportSize / 2
    local myRoot = LocalPlayer.Character and (LocalPlayer.Character:FindFirstChild("HumanoidRootPart") or LocalPlayer.Character:FindFirstChild("Torso") or LocalPlayer.Character:FindFirstChild("Head"))

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character then
            local humanoid = v.Character:FindFirstChild("Humanoid")
            if humanoid and humanoid.Health > 0 then
                local part = v.Character:FindFirstChild("HumanoidRootPart") or v.Character:FindFirstChild("Torso") or v.Character:FindFirstChild("Head")
                if part and myRoot then
                    local worldDist = (myRoot.Position - part.Position).Magnitude
                    if worldDist <= Settings.AimRadius then
                        local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - center).magnitude
                            if dist < shortestDist then
                                closest = v.Character
                                shortestDist = dist
                            end
                        end
                    end
                end
            end
        end
    end

    return closest
end

-- Проверка жива ли цель
local function IsTargetAlive(target)
    if not target then return false end
    local humanoid = target:FindFirstChild("Humanoid")
    return humanoid and humanoid.Health > 0
end

-- BARRAGE (X)
local function StartBarrage()
    if Settings.BarrageActive then return end
    if Settings.BarrageCooldown > 0 then return end
    if Settings.CurrentSpeed < 100 then return end
    if Settings.BloodlustAnimationActive then return end -- Блокируем во время V

    local target = Settings.CurrentTarget or GetClosestPlayer()
    if not target or not IsTargetAlive(target) then return end

    local char = LocalPlayer.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    local targetRoot = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso") or target:FindFirstChild("Head")

    if not root or not targetRoot then return end

    local distance = (root.Position - targetRoot.Position).Magnitude
    if distance > 15 then return end

    Settings.BarrageActive = true
    Settings.BarrageTarget = target
    Settings.BarrageSpeed = Settings.CurrentSpeed
    Settings.BarrageTime = 0
    Settings.BarrageCooldown = Settings.BarrageCooldownDuration

    Settings.CWindowActive = false
    Settings.CCooldownActive = false

    PlaySound("139820826725306", 0.5)
    SetScreenEffect(0.5)

    PlayAnimation("129678103897608", true)

    Settings.stunned = false
end

-- GREATEST HIGH (Z)
local function StartGreatestHigh()
    if Settings.GreatestHighActive then return end
    if Settings.GreatestHighCooldown > 0 then return end
    if not Settings.NaoyaEnabled then return end
    if Settings.CurrentSpeed > 50 then return end
    if Settings.BloodlustAnimationActive then return end -- Блокируем во время V

    local target = Settings.CurrentTarget or GetClosestPlayer()
    if not target or not IsTargetAlive(target) then return end

    local char = LocalPlayer.Character
    if not char then return end

    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("Head")
    local targetRoot = target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso") or target:FindFirstChild("Head")

    if not root or not targetRoot then return end

    local distance = (root.Position - targetRoot.Position).Magnitude
    if distance > Settings.GreatestHighRange then return end

    Settings.GreatestHighActive = true
    Settings.GreatestHighCooldown = Settings.GreatestHighCooldownDuration
    Settings.CCooldownActive = false
    Settings.CWindowActive = false

    CreatePhantom(root.Position)

    PlaySound("75138797742324", 0.5)
    SetScreenEffect(0.5)

    PlayAnimation("120914276661831", false)

    local look = targetRoot.CFrame.LookVector
    local behind = targetRoot.Position - (look * 3)
    root.CFrame = CFrame.new(behind, targetRoot.Position)

    task.delay(0.3, function()
        if root and root.Parent and targetRoot and targetRoot.Parent then
            CreatePhantom(root.Position)

            local front = targetRoot.Position + (look * 3)
            root.CFrame = CFrame.new(front, targetRoot.Position)

            task.delay(0.1, function()
                if root and root.Parent then
                    CreatePhantom(front)
                end
            end)
        end
        Settings.GreatestHighActive = false
        SetScreenEffect(0)
    end)
end

