    local statusText = tapGui:FindFirstChildOfClass("TextLabel")
    local timerText = nil
    for _, child in pairs(tapGui:GetChildren()) do
        if child:IsA("TextLabel") and child ~= statusText then
            timerText = child
            break
        end
    end

    if not statusText or not timerText then return end

    if Settings.Frozen then
        tapGui.Visible = true
        local timeLeft = math.max(0, Settings.FrozenUntil - tick())
        statusText.Text = "❌ FROZEN ❌"
        statusText.TextColor3 = Color3.fromRGB(255, 0, 0)
        timerText.Text = string.format("%.1fs", timeLeft)
        timerText.TextColor3 = Color3.fromRGB(255, 0, 0)
    elseif Settings.DamageStun then
        tapGui.Visible = true
        local timeLeft = math.max(0, Settings.DamageStunEndTime - tick())
        statusText.Text = "💥 STUNNED 💥"
        statusText.TextColor3 = Color3.fromRGB(255, 165, 0)
