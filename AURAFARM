        Settings[var] = not Settings[var]
        btn.BackgroundColor3 = Settings[var] and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(50, 50, 50)
        btn.Text = text .. ": " .. (Settings[var] and "ON" or "OFF")
        if var == "NaoyaEnabled" and Settings[var] then
            PerfectNaoyaMorph()
        end
    end)
end

